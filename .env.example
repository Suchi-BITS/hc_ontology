# Copy to .env and fill in. NEVER commit .env (it is git-ignored).
# Only placeholders belong in this file. See docs/security-and-configuration.md

# ---- Application -------------------------------------------------------
APP_NAME=Healthcare Ontology API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
# Streamlit -> API (match your uvicorn port)
API_BASE_URL=http://127.0.0.1:8000

# ---- Authentication and authorization ----------------------------------------
# Identity, ROLE and TENANT come from a server-side credential record, never from request headers
# (X-Role and X-Tenant-ID are not trusted). Create credentials with:
#   python scripts/dev.py credential add --user <name> --tenant <tenant-id> --role <role>
# They are stored hashed in API_CREDENTIALS_FILE (git-ignored). The key is shown once.
# Roles: viewer, analyst, approver, admin, platform_admin.
API_CREDENTIALS_FILE=.credentials.json
# Legacy single shared key (optional). It maps to ONE server-side identity: DEFAULT_TENANT_ID with API_KEY_ROLE.
API_KEY=
# API_KEY_ROLE=analyst
# ENVIRONMENT decides how strict the server is: development / dev / local and test / testing are
# non-production; anything else (including unset or a typo) is PRODUCTION and requires credentials.
# With no credentials the server refuses to start, unless you explicitly opt in below. The opt-in is
# honoured ONLY in a development or testing ENVIRONMENT and is ignored in production. See docs/security-policy.md.
# Local convenience (the file `python scripts/dev.py setup` creates enables it): authentication disabled,
# every request is an admin "local-developer", announced at startup.
ALLOW_OPEN_DEVELOPMENT_MODE=true
# Reverse proxies whose X-Forwarded-For is believed for rate limiting (comma-separated IPs). Empty = never.
# TRUSTED_PROXIES=

# ---- Ontology / SHACL --------------------------------------------------
# The runtime dataset is two files: the ontology SCHEMA and the synthetic SAMPLE DATA (docs/schema-and-sample-data.md).
ONTOLOGY_SCHEMA_FILE=ontology/healthcare_schema.ttl
# Empty (SAMPLE_DATA_FILE=) runs on the schema alone, with no instances.
SAMPLE_DATA_FILE=data/sample_data.ttl
# SHAPES_DIR=shapes
# DATA_DIR=data
# VALIDATION_REPORTS_DIR=validation_reports
SHACL_VALIDATION_MODE=warn

# ---- Optional AI layer ----------------------------------------------------
# The core API (ontology, SHACL, SPARQL, graph projection) needs none of the settings below.
# false = do not mount the agent, enterprise, embedding and document routers.
# See docs/core-vs-ai-architecture.md.
ENABLE_AI_LAYER=true

# ---- OpenAI (REQUIRED for NL queries, embeddings, GraphRAG, agent) ------
# Ollama is NOT used by the code.
OPENAI_API_KEY=<your-openai-api-key>
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# ---- Neo4j (needed to LOAD the graph; embeddings, documents and agent memory also use it) -----
# The reference environment is a local Neo4j Desktop database (docs/neo4j-desktop.md). Any bolt endpoint works.
# The password is yours: never commit it. NEO4J_USER is accepted as an alias for NEO4J_USERNAME.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
# NEO4J_USER=neo4j
NEO4J_PASSWORD=<your-neo4j-password>
# The database INSIDE the Neo4j server (not the Desktop instance name). Use an EMPTY database for the projection:
# `python scripts/dev.py load` refuses a database that already holds nodes from other graph domains.
NEO4J_DATABASE=neo4j

# ---- LangSmith tracing (OPTIONAL; sends prompts/answers to a third party) -
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=healthcare-ontology-agents
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ---- OpenTelemetry (OPTIONAL) -------------------------------------------
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=

# ---- Neo4j projection safety (development only) -----------------------------
# The Neo4j graph is a DERIVED projection of healthcare_ontology.owl. Resetting it is
# refused unless ENVIRONMENT is a development value AND this flag is true. Even then it
# removes only the projection labels, never agent memory, documents or embeddings.
ALLOW_PROJECTION_RESET=false
# Loading the demo data into Neo4j with scripts/seed_neo4j_demo.py is refused unless this is true AND
# ENVIRONMENT is a development value. There is no HTTP endpoint for it.
ALLOW_DEMO_SEED=false

# ---- Query limits / rate limiting ----------------------------------------
QUERY_DEFAULT_LIMIT=200
QUERY_TIMEOUT_SECONDS=30
# Hard limit for every SPARQL query submitted over HTTP (0.1 to 300). A query that runs longer is
# TERMINATED (its worker process is killed) and the API answers 504. There is no unlimited setting.
SPARQL_QUERY_TIMEOUT_SECONDS=15
# Worker processes that run SPARQL (1 to 8). Each holds one parsed copy of the ontology.
SPARQL_WORKERS=2
QUERY_CACHE_TTL_SECONDS=300
LLM_RATE_LIMIT_PER_MINUTE=10

# ---- Enterprise layer ----------------------------------------------------
DEFAULT_TENANT_ID=default
RBAC_ENABLED=true
GUARDRAILS_ENABLED=true
COST_BUDGET_USD_PER_DAY=25

# ---- Agent / memory (defaults shown; see system_design.md section 13) ----
AGENT_MAX_RETRIES=3
AGENT_FORCE_HITL=false

# ---- Agent behaviour (defaults shown; leave commented to use them) ---------
# AGENT_ABSTENTION_THRESHOLD=0.45
# An ontology-only answer needs a retrieved concept at least this relevant (0 to 1), otherwise the agent refuses.
# AGENT_ONTOLOGY_MIN_RELEVANCE=0.30
# AGENT_RETRIEVAL_POOL_SIZE=16
# AGENT_RETRIEVAL_TOP_K=8
# AGENT_STRUCTURED_LLM=true

# ---- Agent memory (defaults shown) -----------------------------------------
# WORKING_MEMORY_MAX_CHARS=6000
# EPISODIC_CONTEXT_TURNS=5
# EPISODIC_SIMILAR_TOP_K=3
# PROCEDURAL_AUTO_LEARN=true
# PROCEDURAL_MATCH_THRESHOLD=0.35
# PROCEDURAL_MIN_CONFIDENCE=0.7
# SEMANTIC_ENABLE_GRAPH_RAG=true
# META_MEMORY_ENABLED=true
# META_MEMORY_RETAIN_THRESHOLD=0.35
# META_MEMORY_SESSION_ARCHIVE_TURNS=15
# META_MEMORY_KEEP_RECENT_TURNS=5
# META_MEMORY_PURGE_FAILED=false
# META_MEMORY_FAILED_TTL_HOURS=24
# META_MEMORY_PROCEDURE_DECAY_DAYS=30

# ---- Observability ---------------------------------------------------------
# OTEL_SERVICE_NAME=healthcare-ontology-api

# ---- Debugging: prints prompts and ontology context to the terminal -------
# Keep false; never enable with real patient data.
MEMORY_DEBUG_CONTEXT=false
MEMORY_DEBUG_CONTEXT_FULL=false
