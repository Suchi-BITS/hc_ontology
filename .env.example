# Application
APP_NAME=Healthcare Ontology API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
API_BASE_URL=http://127.0.0.1:8000

# Ontology
OWL_FILE_PATH=healthcare_ontology.owl
SHAPES_DIR=shapes
DATA_DIR=data
VALIDATION_REPORTS_DIR=validation_reports
# warn | strict  (strict: warnings also fail conforms)
SHACL_VALIDATION_MODE=warn

# Ollama
OLLAMA_MODEL=qwen2.5:latest
EMBEDDING_MODEL=nomic-embed-text:latest
OLLAMA_HOST=http://127.0.0.1:11434

# Neo4j (database name ≠ Neo4j Desktop instance name)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_password_here
NEO4J_DATABASE=hcontology

# Optional API key (leave empty to disable auth)
API_KEY=

# Query safety / LLM limits
QUERY_DEFAULT_LIMIT=200
QUERY_TIMEOUT_SECONDS=30
LLM_RATE_LIMIT_PER_MINUTE=10
QUERY_CACHE_TTL_SECONDS=300

# Logging
LOG_LEVEL=INFO

# Feature flags
ENABLE_LLM_QUERYING=true
ENABLE_NEO4J_EXPORT=true
