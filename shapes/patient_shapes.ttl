@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix hc:     <http://example.org/healthcare-hospital.owl#> .
@prefix shapes: <http://example.org/healthcare-shapes#> .

# Identity-bearing data a patient record must carry. The role shape owns the
# minCount rules; shared datatype rules come from PersonShape via sh:node.

shapes:PatientShape
    a sh:NodeShape ;
    sh:targetClass hc:Patient ;
    sh:node shapes:PersonShape ;
    sh:property [
        sh:path hc:firstName ;
        sh:minCount 1 ;
        sh:message "Patient must have a firstName." ;
    ] ;
    sh:property [
        sh:path hc:lastName ;
        sh:minCount 1 ;
        sh:message "Patient must have a lastName." ;
    ] ;
    sh:property [
        sh:path hc:dateOfBirth ;
        sh:minCount 1 ;
        sh:message "Patient must have a dateOfBirth." ;
    ] ;
    sh:property [
        sh:path hc:bloodGroup ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:pattern "^(A|B|AB|O)[+-]$" ;
        sh:message "Patient bloodGroup must be a valid ABO type (e.g. O+, A-)." ;
    ] ;
    sh:property [
        sh:path hc:hasDiagnosis ;
        sh:class hc:Diagnosis ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "Patient should have at least one diagnosis." ;
    ] ;
    # Relationship-type guards: a patient's links must point at the right kind of thing.
    # (Subclass membership such as VitalSign -> Observation needs the schema in the data graph.)
    sh:property [
        sh:path hc:hasEncounter ;
        sh:class hc:Encounter ;
        sh:message "hasEncounter must point to an hc:Encounter." ;
    ] ;
    sh:property [
        sh:path hc:hasObservation ;
        sh:class hc:Observation ;
        sh:message "hasObservation must point to an hc:Observation." ;
    ] ;
    sh:property [
        sh:path hc:hasAllergy ;
        sh:class hc:Allergy ;
        sh:message "hasAllergy must point to an hc:Allergy." ;
    ] ;
    sh:property [
        sh:path hc:hasMedicalRecord ;
        sh:class hc:MedicalRecord ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "Patient should have a medical record." ;
    ] .
