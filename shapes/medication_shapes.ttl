@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix hc:     <http://example.org/healthcare-hospital.owl#> .
@prefix shapes: <http://example.org/healthcare-shapes#> .

shapes:MedicationShape
    a sh:NodeShape ;
    sh:targetClass hc:Medication ;
    sh:property [
        sh:path hc:medicationName ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "Medication should have a medicationName." ;
    ] ;
    sh:property [
        sh:path hc:medicationCategory ;
        sh:class hc:MedicationCategory ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "Medication should have a medicationCategory." ;
    ] ;
    sh:property [
        sh:path hc:hasCode ;
        sh:class hc:CodeConcept ;
        sh:severity sh:Info ;
        sh:message "Prefer binding a Medication to a CodeConcept (for example RxNorm) via hasCode." ;
    ] .

# Business rule OWL restrictions cannot express: do not prescribe a drug
# the patient is allergic to (allergyToMedication ∩ containsMedication).
shapes:PrescriptionAllergyConflictShape
    a sh:NodeShape ;
    sh:targetClass hc:Prescription ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Prescription must not contain a medication the patient is allergic to." ;
        sh:select """
            PREFIX hc: <http://example.org/healthcare-hospital.owl#>
            SELECT $this WHERE {
                $this hc:prescribedFor ?patient .
                $this hc:containsMedication ?med .
                ?patient hc:hasAllergy ?allergy .
                ?allergy hc:allergyToMedication ?med .
            }
        """ ;
    ] .

# An allergy record: who has it, and what the patient is allergic to.
shapes:AllergyShape
    a sh:NodeShape ;
    sh:targetClass hc:Allergy ;
    sh:property [
        sh:path hc:allergyToMedication ;
        sh:class hc:Medication ;
        sh:minCount 1 ;
        sh:message "An Allergy must name the medication (hc:Medication) the patient is allergic to." ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath hc:hasAllergy ] ;
        sh:class hc:Patient ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "An Allergy record must belong to exactly one patient (hasAllergy)." ;
    ] .
