### Healthcare Ontology API — example requests
### Use with VS Code REST Client, IntelliJ HTTP Client, or copy curl commands.

@baseUrl = http://127.0.0.1:8000
# Credentials: python scripts/dev.py credential add --user <you> --tenant <tenant> --role <role>
# Then send  X-API-Key: {{apiKey}}  on every request. Roles and tenants come from the server-side
# credential; X-Role / X-Tenant-ID headers are NOT used.
@apiKey = hck_replace_with_your_key
# @apiKey = your-key-here

### System
GET {{baseUrl}}/
X-API-Key: {{apiKey}}
Accept: application/json

###
GET {{baseUrl}}/health
X-API-Key: {{apiKey}}

###
GET {{baseUrl}}/stats
X-API-Key: {{apiKey}}

### Ontology
GET {{baseUrl}}/classes
X-API-Key: {{apiKey}}

###
GET {{baseUrl}}/patients
X-API-Key: {{apiKey}}

###
GET {{baseUrl}}/search?q=hypertension
X-API-Key: {{apiKey}}

### SPARQL
POST {{baseUrl}}/sparql
X-API-Key: {{apiKey}}
Content-Type: application/json

{
  "query": "PREFIX hc: <http://example.org/healthcare-hospital.owl#> SELECT ?patient WHERE { ?patient rdf:type hc:Patient }"
}

### LLM → SPARQL (slow: 1-3 min)
POST {{baseUrl}}/llm-query
X-API-Key: {{apiKey}}
Content-Type: application/json

{
  "question": "Which patients have hypertension?"
}

### Neo4j
GET {{baseUrl}}/neo4j/health
X-API-Key: {{apiKey}}

###
POST {{baseUrl}}/sparql-to-cypher
X-API-Key: {{apiKey}}
Content-Type: application/json

{
  "query": "SELECT ?patient WHERE { ?patient rdf:type :Patient }"
}

###
POST {{baseUrl}}/nl-to-cypher
X-API-Key: {{apiKey}}
Content-Type: application/json

{
  "question": "List all patients"
}

###
POST {{baseUrl}}/execute-cypher
X-API-Key: {{apiKey}}
Content-Type: application/json

{
  "cypher": "MATCH (n:Patient) RETURN n.name AS name LIMIT 10"
}

### Embeddings (run POST /embedding/sync first)
POST {{baseUrl}}/embedding/sync
X-API-Key: {{apiKey}}

###
GET {{baseUrl}}/embedding/health
X-API-Key: {{apiKey}}

###
GET {{baseUrl}}/embedding/search?query=diabetes&top_k=5
X-API-Key: {{apiKey}}

###
GET {{baseUrl}}/metrics
X-API-Key: {{apiKey}}

###
POST {{baseUrl}}/execute-cypher
X-API-Key: {{apiKey}}
Content-Type: application/json

{
  "cypher": "MATCH (n) DETACH DELETE n RETURN n"
}

### SHACL validation
GET {{baseUrl}}/validation/health
X-API-Key: {{apiKey}}

###
POST {{baseUrl}}/validate/ontology
X-API-Key: {{apiKey}}
Content-Type: application/json

{}

###
POST {{baseUrl}}/validate
X-API-Key: {{apiKey}}
Content-Type: application/json

{
  "data": "@prefix hc: <http://example.org/healthcare-hospital.owl#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\nhc:PatientX a hc:Patient ;\n  hc:firstName \"X\"^^xsd:string ;\n  hc:bloodGroup \"O+\"^^xsd:string .",
  "format": "turtle",
  "shape_files": ["patient_shapes.ttl"]
}

###
GET {{baseUrl}}/validation/report
X-API-Key: {{apiKey}}

###
GET {{baseUrl}}/validation/report?format=html
X-API-Key: {{apiKey}}

### Multi-agent LangGraph
GET {{baseUrl}}/agent/health
X-API-Key: {{apiKey}}

###
POST {{baseUrl}}/agent/query
X-API-Key: {{apiKey}}
Content-Type: application/json

{
  "question": "List patients with diabetes",
  "session_id": "demo-session-1",
  "require_human_approval": false,
  "max_retries": 3
}

### Memory cycle lab — reuse session_id; enable MEMORY_DEBUG_CONTEXT=true in .env
POST {{baseUrl}}/agent/query
X-API-Key: {{apiKey}}
Content-Type: application/json

{
  "question": "What is the patient diagnosis for John Doe?",
  "session_id": "memory-lab-1",
  "require_human_approval": false
}

###
POST {{baseUrl}}/agent/query
X-API-Key: {{apiKey}}
Content-Type: application/json

{
  "question": "What diagnosis did we discuss for John Doe earlier?",
  "session_id": "memory-lab-1",
  "require_human_approval": false
}

### HITL: force approval before execution
POST {{baseUrl}}/agent/query
X-API-Key: {{apiKey}}
Content-Type: application/json

{
  "question": "List all patients",
  "session_id": "demo-session-1",
  "require_human_approval": true
}

### Resume after HITL (replace thread_id from previous response)
POST {{baseUrl}}/agent/resume
X-API-Key: {{apiKey}}
Content-Type: application/json

{
  "thread_id": "REPLACE_THREAD_ID",
  "decision": "approved",
  "feedback": "Looks safe"
}

###
GET {{baseUrl}}/agent/state/REPLACE_THREAD_ID
X-API-Key: {{apiKey}}

###
GET {{baseUrl}}/agent/memory/demo-session-1
X-API-Key: {{apiKey}}

