    rdfs:range xsd:string .

hc:insuranceProvider a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "insurance provider"^^xsd:string ;
    rdfs:comment "Insurer name."^^xsd:string ;
    rdfs:domain hc:InsurancePolicy ;
    rdfs:range xsd:string .

hc:invoiceDate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "invoice date"^^xsd:string ;
    rdfs:comment "Calendar date of the invoice."^^xsd:string ;
    rdfs:domain hc:Invoice ;
    rdfs:range xsd:date .

hc:invoiceNumber a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "invoice number"^^xsd:string ;
    rdfs:comment "Invoice number."^^xsd:string ;
    rdfs:domain hc:Invoice ;
    rdfs:range xsd:string .

hc:involvesSurgery a owl:ObjectProperty ;
    rdfs:label "involves surgery"^^xsd:string ;
    rdfs:comment "A surgery that is part of a treatment."^^xsd:string ;
    rdfs:domain hc:Treatment ;
    rdfs:range hc:Surgery ;
    rdfs:subPropertyOf hc:includesProcedure .

hc:isControlledSubstance a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "is controlled substance"^^xsd:string ;
    rdfs:comment "Whether the drug is a controlled substance. A regulatory status, not a therapeutic category."^^xsd:string ;
    rdfs:domain hc:Medication ;
    rdfs:range xsd:boolean .

hc:lastName a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "last name"^^xsd:string ;
    rdfs:comment "Family name. A display attribute, never an identity."^^xsd:string ;
    rdfs:domain hc:Person ;
    rdfs:range xsd:string .

hc:manufacturer a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "manufacturer"^^xsd:string ;
    rdfs:comment "Manufacturer of a medication product."^^xsd:string ;
    rdfs:domain hc:Medication ;
    rdfs:range xsd:string .

hc:maritalStatus a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "marital status"^^xsd:string ;
    rdfs:comment "Marital status as free text."^^xsd:string ;
    rdfs:domain hc:Patient ;
    rdfs:range xsd:string .

hc:medicationName a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "medication name"^^xsd:string ;
    rdfs:comment "Display name of the medication."^^xsd:string ;
    rdfs:domain hc:Medication ;
    rdfs:range xsd:string .

hc:observationUnit a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "observation unit"^^xsd:string ;
    rdfs:comment "Unit of observationValue, as a UCUM code."^^xsd:string ;
    rdfs:domain hc:Observation ;
    rdfs:range xsd:string .

hc:observationValue a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "observation value"^^xsd:string ;
    rdfs:comment "Numeric result. Always accompanied by observationUnit."^^xsd:string ;
    rdfs:domain hc:Observation ;
    rdfs:range xsd:decimal .

hc:observationValueText a owl:DatatypeProperty ;
    rdfs:label "observation value text"^^xsd:string ;
    rdfs:comment "Non-numeric result as text."^^xsd:string ;
    rdfs:domain hc:Observation ;
    rdfs:range xsd:string .

hc:onsetDate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "onset date"^^xsd:string ;
    rdfs:comment "Date the condition began. xsd:date because onset is rarely known more precisely."^^xsd:string ;
    rdfs:domain hc:Condition ;
    rdfs:range xsd:date .

hc:patientStatus a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "patient status"^^xsd:string ;
    rdfs:comment "Administrative status of the patient record."^^xsd:string ;
    rdfs:domain hc:Patient ;
    rdfs:range xsd:string .

hc:paymentStatus a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "payment status"^^xsd:string ;
    rdfs:comment "Payment status."^^xsd:string ;
    rdfs:domain hc:Billing ;
    rdfs:range xsd:string .

hc:performedByDoctor a owl:ObjectProperty ;
    rdfs:label "performed by doctor"^^xsd:string ;
    rdfs:comment "The doctor responsible for a treatment."^^xsd:string ;
    rdfs:domain hc:Treatment ;
    rdfs:range hc:Doctor .

hc:performedDateTime a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "performed date time"^^xsd:string ;
    rdfs:comment "Instant the procedure was performed. xsd:dateTime with a time zone offset."^^xsd:string ;
    rdfs:domain hc:Procedure ;
    rdfs:range xsd:dateTime .

hc:phoneNumber a owl:DatatypeProperty ;
    rdfs:label "phone number"^^xsd:string ;
    rdfs:comment "Contact telephone number."^^xsd:string ;
    rdfs:domain hc:Person ;
    rdfs:range xsd:string .

hc:policyNumber a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "policy number"^^xsd:string ;
    rdfs:comment "Policy number."^^xsd:string ;
    rdfs:domain hc:InsurancePolicy ;
    rdfs:range xsd:string .

hc:prescriptionDate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "prescription date"^^xsd:string ;
    rdfs:comment "Calendar date the prescription was issued."^^xsd:string ;
    rdfs:domain hc:Prescription ;
    rdfs:range xsd:date .

hc:prescriptionNumber a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "prescription number"^^xsd:string ;
    rdfs:comment "Local prescription number."^^xsd:string ;
    rdfs:domain hc:Prescription ;
    rdfs:range xsd:string .

hc:procedureName a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "procedure name"^^xsd:string ;
    rdfs:comment "Display name of the procedure."^^xsd:string ;
    rdfs:domain hc:Procedure ;
    rdfs:range xsd:string .

hc:recordCreatedDate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "record created date"^^xsd:string ;
    rdfs:comment "Calendar date the record was opened."^^xsd:string ;
    rdfs:domain hc:MedicalRecord ;
    rdfs:range xsd:date .

hc:recordNumber a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "record number"^^xsd:string ;
    rdfs:comment "Local medical record number."^^xsd:string ;
    rdfs:domain hc:MedicalRecord ;
    rdfs:range xsd:string .

hc:recordedBy a owl:ObjectProperty ;
    rdfs:label "recorded by"^^xsd:string ;
    rdfs:comment "The practitioner who recorded an observation."^^xsd:string ;
    rdfs:domain hc:Observation ;
    rdfs:range hc:Practitioner .

hc:resultStatus a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "result status"^^xsd:string ;
    rdfs:comment "Status of the result (for example Preliminary, Final)."^^xsd:string ;
    rdfs:domain hc:DiagnosticResult ;
    rdfs:range xsd:string .

hc:reviewedByDoctor a owl:ObjectProperty ;
    rdfs:label "reviewed by doctor"^^xsd:string ;
    rdfs:comment "The doctor who reviewed a result."^^xsd:string ;
    rdfs:domain hc:DiagnosticResult ;
    rdfs:range hc:Doctor .

hc:roomNumber a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "room number"^^xsd:string ;
    rdfs:comment "Room number."^^xsd:string ;
    rdfs:domain hc:Room ;
    rdfs:range xsd:string .

hc:roomType a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "room type"^^xsd:string ;
    rdfs:comment "Kind of room."^^xsd:string ;
    rdfs:domain hc:Room ;
    rdfs:range xsd:string .

hc:scheduledStart a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "scheduled start"^^xsd:string ;
    rdfs:comment "Planned start instant. xsd:dateTime with a time zone offset."^^xsd:string ;
    rdfs:domain hc:Appointment ;
    rdfs:range xsd:dateTime .

hc:serviceProvider a owl:ObjectProperty ;
    rdfs:label "service provider"^^xsd:string ;
    rdfs:comment "The organization responsible for the encounter."^^xsd:string ;
    rdfs:domain hc:Encounter ;
    rdfs:range hc:Organization .

hc:shiftType a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "shift type"^^xsd:string ;
    rdfs:comment "Usual shift pattern."^^xsd:string ;
    rdfs:domain hc:Nurse ;
    rdfs:range xsd:string .

hc:submitsClaim a owl:ObjectProperty ;
    rdfs:label "submits claim"^^xsd:string ;
    rdfs:comment "A claim submitted from a billing entry."^^xsd:string ;
    rdfs:domain hc:Billing ;
    rdfs:range hc:InsuranceClaim .

hc:surgeryDurationMinutes a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "surgery duration minutes"^^xsd:string ;
    rdfs:comment "Duration of the surgery in minutes."^^xsd:string ;
    rdfs:domain hc:Surgery ;
    rdfs:range xsd:integer .

hc:testDate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "test date"^^xsd:string ;
    rdfs:comment "Calendar date the test was performed."^^xsd:string ;
    rdfs:domain hc:DiagnosticTest ;
    rdfs:range xsd:date .

hc:testName a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "test name"^^xsd:string ;
    rdfs:comment "Display name of the test."^^xsd:string ;
    rdfs:domain hc:DiagnosticTest ;
    rdfs:range xsd:string .

hc:totalBeds a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "total beds"^^xsd:string ;
    rdfs:comment "Total number of beds."^^xsd:string ;
    rdfs:domain hc:Hospital ;
    rdfs:range xsd:integer .

hc:transportedBy a owl:ObjectProperty ;
    rdfs:label "transported by"^^xsd:string ;
    rdfs:comment "The ambulance that brought the patient to this encounter."^^xsd:string ;
    rdfs:domain hc:Encounter ;
    rdfs:range hc:Ambulance .

hc:treatmentCost a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "treatment cost"^^xsd:string ;
    rdfs:comment "Cost of the treatment."^^xsd:string ;
    rdfs:domain hc:Treatment ;
    rdfs:range xsd:decimal .

hc:treatmentId a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "treatment id"^^xsd:string ;
    rdfs:comment "Local treatment number."^^xsd:string ;
    rdfs:domain hc:Treatment ;
    rdfs:range xsd:string .

hc:treatmentName a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "treatment name"^^xsd:string ;
    rdfs:comment "Display name of the treatment."^^xsd:string ;
    rdfs:domain hc:Treatment ;
    rdfs:range xsd:string .

hc:treatmentStatus a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "treatment status"^^xsd:string ;
    rdfs:comment "Planned, Active, Completed or Cancelled."^^xsd:string ;
    rdfs:domain hc:Treatment ;
    rdfs:range xsd:string .

hc:usesMedicalDevice a owl:ObjectProperty ;
    rdfs:label "uses medical device"^^xsd:string ;
    rdfs:comment "A device used in a treatment."^^xsd:string ;
    rdfs:domain hc:Treatment ;
    rdfs:range hc:MedicalDevice .

hc:yearsOfExperience a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "years of experience"^^xsd:string ;
    rdfs:comment "Years of professional experience."^^xsd:string ;
    rdfs:domain hc:Doctor ;
    rdfs:range xsd:integer .

hc:Ambulance a owl:Class ;
    rdfs:label "Ambulance"^^xsd:string ;
    rdfs:comment "A vehicle used to transport patients to or between care locations."^^xsd:string ;
    rdfs:subClassOf owl:Thing .

hc:EncounterTypeInpatient a hc:EncounterType,
        owl:NamedIndividual ;
    rdfs:label "Inpatient"^^xsd:string ;
    skos:inScheme hc:EncounterTypeScheme ;
    skos:notation "IMP"^^xsd:string ;
    skos:prefLabel "Inpatient"@en .

hc:ImagingStudy a owl:Class ;
    rdfs:label "Imaging Study"^^xsd:string ;
    rdfs:comment "A DiagnosticTest that produces images, for example MRI or X-ray. Not a laboratory test."^^xsd:string ;
    rdfs:subClassOf hc:DiagnosticTest .

hc:MedCategoryAntidiabetic a hc:MedicationCategory,
        owl:NamedIndividual ;
    rdfs:label "Antidiabetic"^^xsd:string ;
    skos:inScheme hc:MedicationCategoryScheme ;
    skos:prefLabel "Antidiabetic"@en .

hc:MedicalDevice a owl:Class ;
    rdfs:label "Medical Device"^^xsd:string ;
    rdfs:comment "A device used in diagnosis or treatment."^^xsd:string ;
    rdfs:subClassOf owl:Thing .

hc:Nurse a owl:Class ;
    rdfs:label "Nurse"^^xsd:string ;
    rdfs:comment "A practitioner providing nursing care."^^xsd:string ;
    rdfs:subClassOf hc:Practitioner .

hc:allergyForPatient a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "allergy for patient"^^xsd:string ;
    rdfs:comment "The patient this allergy is recorded for. Inferred as the inverse of hasAllergy."^^xsd:string ;
    rdfs:domain hc:Allergy ;
    rdfs:range hc:Patient ;
    owl:inverseOf hc:hasAllergy .

hc:appointmentForPatient a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "appointment for patient"^^xsd:string ;
    rdfs:comment "The patient an appointment is for. Inferred as the inverse of hasAppointment."^^xsd:string ;
    rdfs:domain hc:Appointment ;
    rdfs:range hc:Patient ;
    owl:inverseOf hc:hasAppointment .

hc:belongsToHospital a owl:ObjectProperty ;
    rdfs:label "belongs to hospital"^^xsd:string ;
    rdfs:comment "The hospital that this department is part of. Inferred as the inverse of hasDepartment."^^xsd:string ;
    rdfs:domain hc:Department ;
    rdfs:range hc:Hospital ;
    owl:inverseOf hc:hasDepartment .

hc:containedInPrescription a owl:ObjectProperty ;
    rdfs:label "contained in prescription"^^xsd:string ;
    rdfs:comment "A prescription that lists this medication. Inferred as the inverse of containsMedication."^^xsd:string ;
    rdfs:domain hc:Medication ;
    rdfs:range hc:Prescription ;
    owl:inverseOf hc:containsMedication .

hc:containsBed a owl:ObjectProperty ;
    rdfs:label "contains bed"^^xsd:string ;
    rdfs:comment "A room contains this bed."^^xsd:string ;
    rdfs:domain hc:Room ;
    rdfs:range hc:Bed ;
    owl:inverseOf hc:locatedInRoom .

hc:containsMedication a owl:ObjectProperty ;
    rdfs:label "contains medication"^^xsd:string ;
    rdfs:comment "A medication listed on a prescription."^^xsd:string ;
    rdfs:domain hc:Prescription ;
    rdfs:range hc:Medication ;
    owl:inverseOf hc:containedInPrescription .

hc:containsRoom a owl:ObjectProperty ;
    rdfs:label "contains room"^^xsd:string ;
    rdfs:comment "A ward contains this room."^^xsd:string ;
    rdfs:domain hc:Ward ;
    rdfs:range hc:Room ;
    owl:inverseOf hc:locatedInWard .

hc:containsWard a owl:ObjectProperty ;
    rdfs:label "contains ward"^^xsd:string ;
    rdfs:comment "A department operates this ward."^^xsd:string ;
    rdfs:domain hc:Department ;
    rdfs:range hc:Ward ;
    owl:inverseOf hc:wardOfDepartment .

hc:diagnosedBy a owl:ObjectProperty ;
    rdfs:label "diagnosed by"^^xsd:string ;
    rdfs:comment "The doctor who established this diagnosis."^^xsd:string ;
    rdfs:domain hc:Diagnosis ;
    rdfs:range hc:Doctor ;
    owl:inverseOf hc:madeDiagnosis .

hc:diagnosedIn a owl:ObjectProperty ;
    rdfs:label "diagnosed in"^^xsd:string ;
    rdfs:comment "The encounter during which this condition was identified. Inferred as the inverse of diagnoses."^^xsd:string ;
    rdfs:domain hc:Condition ;
    rdfs:range hc:Encounter ;
    owl:inverseOf hc:diagnoses .

hc:diagnoses a owl:ObjectProperty ;
    rdfs:label "diagnoses"^^xsd:string ;
    rdfs:comment "A condition identified or confirmed during this encounter."^^xsd:string ;
    rdfs:domain hc:Encounter ;
    rdfs:range hc:Condition ;
    owl:inverseOf hc:diagnosedIn .

hc:diagnosisForPatient a owl:ObjectProperty ;
    rdfs:label "diagnosis for patient"^^xsd:string ;
    rdfs:comment "The patient a diagnosis belongs to. Inferred as the inverse of hasDiagnosis."^^xsd:string ;
    rdfs:domain hc:Diagnosis ;
    rdfs:range hc:Patient ;
    rdfs:subPropertyOf hc:conditionSubject ;
    owl:inverseOf hc:hasDiagnosis .

hc:encounterForPatient a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "encounter for patient"^^xsd:string ;
    rdfs:comment "The patient who is the subject of this encounter. Inferred as the inverse of hasEncounter."^^xsd:string ;
    rdfs:domain hc:Encounter ;
    rdfs:range hc:Patient ;
    owl:inverseOf hc:hasEncounter .

hc:encounterType a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "encounter type"^^xsd:string ;
    rdfs:comment "The care setting of this encounter."^^xsd:string ;
    rdfs:domain hc:Encounter ;
    rdfs:range hc:EncounterType .

hc:fulfilledBy a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "fulfilled by"^^xsd:string ;
    rdfs:comment "The encounter that fulfilled this appointment."^^xsd:string ;
    rdfs:domain hc:Appointment ;
    rdfs:range hc:Encounter ;
    owl:inverseOf hc:fulfillsAppointment .

hc:fulfillsAppointment a owl:ObjectProperty ;
    rdfs:label "fulfills appointment"^^xsd:string ;
    rdfs:comment "The appointment that this encounter fulfilled. Inferred as the inverse of fulfilledBy."^^xsd:string ;
    rdfs:domain hc:Encounter ;
    rdfs:range hc:Appointment ;
    owl:inverseOf hc:fulfilledBy .

hc:hasAllergy a owl:ObjectProperty ;
    rdfs:label "has allergy"^^xsd:string ;
    rdfs:comment "An allergy recorded for a patient."^^xsd:string ;
    rdfs:domain hc:Patient ;
    rdfs:range hc:Allergy ;
    owl:inverseOf hc:allergyForPatient .

hc:hasAppointment a owl:ObjectProperty ;
    rdfs:label "has appointment"^^xsd:string ;
    rdfs:comment "A patient has this appointment."^^xsd:string ;
    rdfs:domain hc:Patient ;
    rdfs:range hc:Appointment ;
    owl:inverseOf hc:appointmentForPatient .

hc:hasDepartment a owl:ObjectProperty ;
    rdfs:label "has department"^^xsd:string ;
    rdfs:comment "A hospital has this department."^^xsd:string ;
    rdfs:domain hc:Hospital ;
    rdfs:range hc:Department ;
    owl:inverseOf hc:belongsToHospital .

hc:hasDiagnosis a owl:ObjectProperty ;
    rdfs:label "has diagnosis"^^xsd:string ;
    rdfs:comment "A patient has this diagnosis."^^xsd:string ;
    rdfs:domain hc:Patient ;
    rdfs:range hc:Diagnosis ;
    rdfs:subPropertyOf hc:hasCondition ;
    owl:inverseOf hc:diagnosisForPatient .

hc:hasEncounter a owl:ObjectProperty ;
    rdfs:label "has encounter"^^xsd:string ;
    rdfs:comment "A patient took part in this encounter."^^xsd:string ;
    rdfs:domain hc:Patient ;
    rdfs:range hc:Encounter ;
    owl:inverseOf hc:encounterForPatient .

hc:hasObservation a owl:ObjectProperty ;
    rdfs:label "has observation"^^xsd:string ;
    rdfs:comment "An observation made about a patient."^^xsd:string ;
    rdfs:domain hc:Patient ;
    rdfs:range hc:Observation ;
    owl:inverseOf hc:observationForPatient .

hc:hasParticipant a owl:ObjectProperty ;
    rdfs:label "has participant"^^xsd:string ;
    rdfs:comment "A practitioner who took part in this encounter. Inferred as the inverse of participatesIn."^^xsd:string ;
    rdfs:domain hc:Encounter ;
    rdfs:range hc:Practitioner ;
    owl:inverseOf hc:participatesIn .

hc:hasPrescription a owl:ObjectProperty ;
    rdfs:label "has prescription"^^xsd:string ;
    rdfs:comment "A prescription issued for a patient. Inferred as the inverse of prescribedFor."^^xsd:string ;
    rdfs:domain hc:Patient ;
    rdfs:range hc:Prescription ;
    owl:inverseOf hc:prescribedFor .

hc:hasStaffMember a owl:ObjectProperty ;
    rdfs:label "has staff member"^^xsd:string ;
    rdfs:comment "A person who works in this department. Inferred as the inverse of worksInDepartment."^^xsd:string ;
    rdfs:domain hc:Department ;
    rdfs:range hc:Person ;
    owl:inverseOf hc:worksInDepartment .

hc:includesObservation a owl:ObjectProperty ;
    rdfs:label "includes observation"^^xsd:string ;
    rdfs:comment "An observation made during this encounter."^^xsd:string ;
    rdfs:domain hc:Encounter ;
    rdfs:range hc:Observation ;
    owl:inverseOf hc:observedDuring .

hc:includesProcedure a owl:ObjectProperty ;
    rdfs:label "includes procedure"^^xsd:string ;
    rdfs:comment "A procedure that is part of a treatment."^^xsd:string ;
    rdfs:domain hc:Treatment ;
    rdfs:range hc:Procedure .

hc:involvesProcedure a owl:ObjectProperty ;
    rdfs:label "involves procedure"^^xsd:string ;
    rdfs:comment "A procedure performed during this encounter."^^xsd:string ;
    rdfs:domain hc:Encounter ;
    rdfs:range hc:Procedure ;
    owl:inverseOf hc:performedDuring .

hc:issuedPrescription a owl:ObjectProperty ;
    rdfs:label "issued prescription"^^xsd:string ;
    rdfs:comment "A prescription this doctor issued. Inferred as the inverse of prescribedBy."^^xsd:string ;
    rdfs:domain hc:Doctor ;
    rdfs:range hc:Prescription ;
    owl:inverseOf hc:prescribedBy .

hc:locatedInRoom a owl:ObjectProperty ;
    rdfs:label "located in room"^^xsd:string ;
    rdfs:comment "The room containing this bed. Inverse of containsBed."^^xsd:string ;
    rdfs:domain hc:Bed ;
    rdfs:range hc:Room ;
    rdfs:subPropertyOf hc:partOfLocation ;
    owl:inverseOf hc:containsBed .

hc:locatedInWard a owl:ObjectProperty ;
    rdfs:label "located in ward"^^xsd:string ;
    rdfs:comment "The ward containing this room. Inverse of containsRoom."^^xsd:string ;
    rdfs:domain hc:Room ;
    rdfs:range hc:Ward ;
    rdfs:subPropertyOf hc:partOfLocation ;
    owl:inverseOf hc:containsRoom .

hc:madeDiagnosis a owl:ObjectProperty ;
    rdfs:label "made diagnosis"^^xsd:string ;
    rdfs:comment "A diagnosis this doctor established. Inferred as the inverse of diagnosedBy."^^xsd:string ;
    rdfs:domain hc:Doctor ;
    rdfs:range hc:Diagnosis ;
    owl:inverseOf hc:diagnosedBy .

hc:managedBy a owl:ObjectProperty ;
    rdfs:label "managed by"^^xsd:string ;
    rdfs:comment "An administrator who manages this department. Inferred as the inverse of managesDepartment."^^xsd:string ;
    rdfs:domain hc:Department ;
    rdfs:range hc:Administrator ;
    owl:inverseOf hc:managesDepartment .

hc:managesDepartment a owl:ObjectProperty ;
    rdfs:label "manages department"^^xsd:string ;
    rdfs:comment "An administrator manages this department."^^xsd:string ;
    rdfs:domain hc:Administrator ;
    rdfs:range hc:Department ;
    owl:inverseOf hc:managedBy .

hc:medicationCategory a owl:ObjectProperty ;
    rdfs:label "medication category"^^xsd:string ;
    rdfs:comment "A therapeutic category of a medication. A medication may have several."^^xsd:string ;
    rdfs:domain hc:Medication ;
    rdfs:range hc:MedicationCategory .

hc:observationForPatient a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "observation for patient"^^xsd:string ;
    rdfs:comment "The patient an observation is about. Inferred as the inverse of hasObservation."^^xsd:string ;
    rdfs:domain hc:Observation ;
    rdfs:range hc:Patient ;
    owl:inverseOf hc:hasObservation .

hc:observedDuring a owl:ObjectProperty ;
    rdfs:label "observed during"^^xsd:string ;
    rdfs:comment "The encounter during which this observation was made. Inferred as the inverse of includesObservation."^^xsd:string ;
    rdfs:domain hc:Observation ;
    rdfs:range hc:Encounter ;
    owl:inverseOf hc:includesObservation .

hc:orderedBy a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "ordered by"^^xsd:string ;
    rdfs:comment "The practitioner who ordered this test. Inferred as the inverse of orderedTest."^^xsd:string ;
    rdfs:domain hc:DiagnosticTest ;
    rdfs:range hc:Practitioner ;
    owl:inverseOf hc:orderedTest .

hc:orderedTest a owl:ObjectProperty ;
    rdfs:label "ordered test"^^xsd:string ;
    rdfs:comment "A diagnostic test ordered by a practitioner."^^xsd:string ;
    rdfs:domain hc:Practitioner ;
    rdfs:range hc:DiagnosticTest ;
    owl:inverseOf hc:orderedBy .

hc:participatesIn a owl:ObjectProperty ;
    rdfs:label "participates in"^^xsd:string ;
    rdfs:comment "A practitioner took part in this encounter."^^xsd:string ;
    rdfs:domain hc:Practitioner ;
    rdfs:range hc:Encounter ;
    owl:inverseOf hc:hasParticipant .

hc:performedDuring a owl:ObjectProperty ;
    rdfs:label "performed during"^^xsd:string ;
    rdfs:comment "The encounter during which this procedure was performed. Inferred as the inverse of involvesProcedure."^^xsd:string ;
    rdfs:domain hc:Procedure ;
    rdfs:range hc:Encounter ;
    owl:inverseOf hc:involvesProcedure .

hc:prescribedBy a owl:ObjectProperty ;
    rdfs:label "prescribed by"^^xsd:string ;
    rdfs:comment "The doctor who issued a prescription."^^xsd:string ;
    rdfs:domain hc:Prescription ;
    rdfs:range hc:Doctor ;
    owl:inverseOf hc:issuedPrescription .

hc:prescribedFor a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "prescribed for"^^xsd:string ;
    rdfs:comment "The patient a prescription is for."^^xsd:string ;
    rdfs:domain hc:Prescription ;
    rdfs:range hc:Patient ;
    owl:inverseOf hc:hasPrescription .

hc:producesResult a owl:ObjectProperty ;
    rdfs:label "produces result"^^xsd:string ;
    rdfs:comment "The result produced by a test."^^xsd:string ;
    rdfs:domain hc:DiagnosticTest ;
    rdfs:range hc:DiagnosticResult ;
    owl:inverseOf hc:resultOfTest .

hc:receivesTreatment a owl:ObjectProperty ;
    rdfs:label "receives treatment"^^xsd:string ;
    rdfs:comment "A treatment a patient receives."^^xsd:string ;
    rdfs:domain hc:Patient ;
    rdfs:range hc:Treatment ;
    owl:inverseOf hc:treatmentForPatient .

hc:reportsTo a owl:ObjectProperty ;
    rdfs:label "reports to"^^xsd:string ;
    rdfs:comment "A person reports to another person in the staff hierarchy."^^xsd:string ;
    rdfs:domain hc:Person ;
    rdfs:range hc:Person ;
    owl:inverseOf hc:supervises .

hc:requiresTreatment a owl:ObjectProperty ;
    rdfs:label "requires treatment"^^xsd:string ;
    rdfs:comment "A treatment that this diagnosis calls for."^^xsd:string ;
    rdfs:domain hc:Diagnosis ;
    rdfs:range hc:Treatment ;
    owl:inverseOf hc:treatsDiagnosis .

hc:resultOfTest a owl:ObjectProperty ;
    rdfs:label "result of test"^^xsd:string ;
    rdfs:comment "The test that produced a result. Inferred as the inverse of producesResult."^^xsd:string ;
    rdfs:domain hc:DiagnosticResult ;
    rdfs:range hc:DiagnosticTest ;
    owl:inverseOf hc:producesResult .

hc:supervises a owl:ObjectProperty ;
    rdfs:label "supervises"^^xsd:string ;
    rdfs:comment "A person who reports to this person in the staff hierarchy. Inferred as the inverse of reportsTo."^^xsd:string ;
    rdfs:domain hc:Person ;
    rdfs:range hc:Person ;
    owl:inverseOf hc:reportsTo .

hc:testForPatient a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "test for patient"^^xsd:string ;
    rdfs:comment "The patient this test was performed on. Inferred as the inverse of underwentTest."^^xsd:string ;
    rdfs:domain hc:DiagnosticTest ;
    rdfs:range hc:Patient ;
    owl:inverseOf hc:underwentTest .

hc:treatmentForPatient a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "treatment for patient"^^xsd:string ;
    rdfs:comment "The patient who receives this treatment. Inferred as the inverse of receivesTreatment."^^xsd:string ;
    rdfs:domain hc:Treatment ;
    rdfs:range hc:Patient ;
    owl:inverseOf hc:receivesTreatment .

hc:treatsDiagnosis a owl:ObjectProperty ;
    rdfs:label "treats diagnosis"^^xsd:string ;
    rdfs:comment "A diagnosis that this treatment addresses. Inferred as the inverse of requiresTreatment."^^xsd:string ;
    rdfs:domain hc:Treatment ;
    rdfs:range hc:Diagnosis ;
    owl:inverseOf hc:requiresTreatment .

hc:underwentTest a owl:ObjectProperty ;
    rdfs:label "underwent test"^^xsd:string ;
    rdfs:comment "A diagnostic test performed on a patient."^^xsd:string ;
    rdfs:domain hc:Patient ;
    rdfs:range hc:DiagnosticTest ;
    owl:inverseOf hc:testForPatient .

hc:wardOfDepartment a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "ward of department"^^xsd:string ;
    rdfs:comment "The department that operates this ward. Inferred as the inverse of containsWard."^^xsd:string ;
    rdfs:domain hc:Ward ;
    rdfs:range hc:Department ;
    owl:inverseOf hc:containsWard .

hc:worksInDepartment a owl:ObjectProperty ;
    rdfs:label "works in department"^^xsd:string ;
    rdfs:comment "A person works in this department."^^xsd:string ;
    rdfs:domain hc:Person ;
    rdfs:range hc:Department ;
    owl:inverseOf hc:hasStaffMember .

hc:Administrator a owl:Class ;
    rdfs:label "Administrator"^^xsd:string ;
    rdfs:comment "A non-clinical staff member who manages organizational units."^^xsd:string ;
    rdfs:subClassOf hc:Person .

hc:ClinicalNote a owl:Class ;
    rdfs:label "Clinical Note"^^xsd:string ;
    rdfs:comment "A free-text clinical document authored by a practitioner."^^xsd:string ;
    rdfs:subClassOf owl:Thing .

hc:InsuranceClaim a owl:Class ;
    rdfs:label "Insurance Claim"^^xsd:string ;
    rdfs:comment "A request to an insurer for payment of services."^^xsd:string ;
    rdfs:subClassOf owl:Thing .

hc:Surgery a owl:Class ;
    rdfs:label "Surgery"^^xsd:string ;
    rdfs:comment "A Procedure that involves cutting or other operative intervention."^^xsd:string ;
    rdfs:subClassOf hc:Procedure .

hc:Vaccination a owl:Class ;
    rdfs:label "Vaccination"^^xsd:string ;
    rdfs:comment "An administration of a vaccine to a patient."^^xsd:string ;
    rdfs:subClassOf owl:Thing .

hc:conditionSubject a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "condition subject"^^xsd:string ;
    rdfs:comment "The patient a condition belongs to. A condition record belongs to exactly one patient."^^xsd:string ;
    rdfs:domain hc:Condition ;
    rdfs:range hc:Patient ;
    owl:inverseOf hc:hasCondition .

hc:hasCondition a owl:ObjectProperty ;
    rdfs:label "has condition"^^xsd:string ;
    rdfs:comment "A patient has this condition."^^xsd:string ;
    rdfs:domain hc:Patient ;
    rdfs:range hc:Condition ;
    owl:inverseOf hc:conditionSubject .

hc:partOfLocation a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "part of location"^^xsd:string ;
    rdfs:comment "Transitive physical containment: a bed is part of its room, ward and so on."^^xsd:string ;
    rdfs:domain hc:Location ;
    rdfs:range hc:Location .

hc:CarePlan a owl:Class ;
    rdfs:label "Care Plan"^^xsd:string ;
    rdfs:comment "A plan of care created by a practitioner for a patient."^^xsd:string ;
    rdfs:subClassOf owl:Thing .

hc:Invoice a owl:Class ;
    rdfs:label "Invoice"^^xsd:string ;
    rdfs:comment "A request for payment issued from a Billing entry."^^xsd:string ;
    rdfs:subClassOf owl:Thing .

hc:AdministrativeGenderScheme a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Administrative gender"^^xsd:string ;
    skos:prefLabel "Administrative gender"@en .

hc:Allergy a owl:Class ;
    rdfs:label "Allergy"^^xsd:string ;
    rdfs:comment "A patient's recorded adverse reaction to a substance (equivalent to a FHIR AllergyIntolerance)."^^xsd:string ;
    rdfs:subClassOf owl:Thing .

hc:DiagnosticResult a owl:Class ;
    rdfs:label "Diagnostic Result"^^xsd:string ;
    rdfs:comment "An Observation that is the outcome of a diagnostic test."^^xsd:string ;
    rdfs:subClassOf hc:Observation .

hc:EncounterTypeScheme a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Encounter type"^^xsd:string ;
    skos:prefLabel "Encounter type"@en .

hc:MedicalRecord a owl:Class ;
    rdfs:label "Medical Record"^^xsd:string ;
    rdfs:comment "The container for a patient's clinical documentation."^^xsd:string ;
    rdfs:subClassOf owl:Thing .

hc:Bed a owl:Class ;
    rdfs:label "Bed"^^xsd:string ;
    rdfs:comment "A single bed within a room; the smallest placement unit."^^xsd:string ;
    rdfs:subClassOf hc:Location .

hc:CodeConcept a owl:Class ;
    rdfs:label "Code Concept"^^xsd:string ;
    rdfs:comment "A reference to a concept in an external code system (codeSystem + codeValue + codeDisplay). The terminology itself is not stored."^^xsd:string ;
    rdfs:subClassOf owl:Thing .

hc:InsurancePolicy a owl:Class ;
    rdfs:label "Insurance Policy"^^xsd:string ;
    rdfs:comment "A health insurance coverage agreement."^^xsd:string ;
    rdfs:subClassOf owl:Thing .

hc:Ward a owl:Class ;
    rdfs:label "Ward"^^xsd:string ;
    rdfs:comment "A group of rooms within a hospital operated for a category of care."^^xsd:string ;
    rdfs:subClassOf hc:Location .

hc:AdministrativeGender a owl:Class ;
    rdfs:label "Administrative Gender"^^xsd:string ;
    rdfs:comment "The administrative gender used for record keeping (male, female, other, unknown)."^^xsd:string ;
    rdfs:subClassOf skos:Concept .

hc:Billing a owl:Class ;
    rdfs:label "Billing"^^xsd:string ;
    rdfs:comment "A billing account entry for services provided to a patient."^^xsd:string ;
    rdfs:subClassOf owl:Thing .

hc:EncounterType a owl:Class ;
    rdfs:label "Encounter Type"^^xsd:string ;
    rdfs:comment "The setting of an Encounter: ambulatory, inpatient, emergency, or virtual."^^xsd:string ;
    rdfs:subClassOf skos:Concept .

hc:Identifier a owl:Class ;
    rdfs:label "Identifier"^^xsd:string ;
    rdfs:comment "A business identifier assigned by an issuing system, for example a medical record number or a license number."^^xsd:string ;
    rdfs:subClassOf owl:Thing .

hc:Organization a owl:Class ;
    rdfs:label "Organization"^^xsd:string ;
    rdfs:comment "A formally or informally recognized group of people that provides or administers healthcare."^^xsd:string ;
    rdfs:subClassOf owl:Thing .

hc:Location a owl:Class ;
    rdfs:label "Location"^^xsd:string ;
    rdfs:comment "A physical place where care can be delivered or a patient can be placed."^^xsd:string ;
    rdfs:subClassOf owl:Thing .

hc:MedicationCategoryScheme a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Medication category"^^xsd:string ;
    skos:prefLabel "Medication category"@en .

hc:Hospital a owl:Class ;
    rdfs:label "Hospital"^^xsd:string ;
    rdfs:comment "An organization providing inpatient and outpatient medical services."^^xsd:string ;
    rdfs:subClassOf hc:Organization .

hc:Procedure a owl:Class ;
    rdfs:label "Procedure"^^xsd:string ;
    rdfs:comment "An action performed on or for a patient, such as a surgery or an electrocardiogram."^^xsd:string ;
    rdfs:subClassOf owl:Thing .

hc:Room a owl:Class ;
    rdfs:label "Room"^^xsd:string ;
    rdfs:comment "A room within a ward, used to place beds and patients."^^xsd:string ;
    rdfs:subClassOf hc:Location .

hc:Diagnosis a owl:Class ;
    rdfs:label "Diagnosis"^^xsd:string ;
    rdfs:comment "A Condition established by a clinician's judgement."^^xsd:string ;
    rdfs:subClassOf hc:Condition .

hc:MedicationCategory a owl:Class ;
    rdfs:label "Medication Category"^^xsd:string ;
    rdfs:comment "A therapeutic category of a Medication, such as analgesic or antidiabetic."^^xsd:string ;
    rdfs:subClassOf skos:Concept .

hc:Condition a owl:Class ;
    rdfs:label "Condition"^^xsd:string ;
    rdfs:comment "A clinical problem, disease, or health state of a patient, recorded for one patient at a point in time."^^xsd:string ;
    rdfs:subClassOf owl:Thing .

hc:Doctor a owl:Class ;
    rdfs:label "Doctor"^^xsd:string ;
    rdfs:comment "A licensed medical practitioner. Clinical specialty is NOT a subclass: see hasSpecialty."^^xsd:string ;
    rdfs:subClassOf hc:Practitioner .

hc:Prescription a owl:Class ;
    rdfs:label "Prescription"^^xsd:string ;
    rdfs:comment "An order by a practitioner to supply medication to a patient (equivalent to a FHIR MedicationRequest)."^^xsd:string ;
    rdfs:subClassOf owl:Thing .

hc:Appointment a owl:Class ;
    rdfs:label "Appointment"^^xsd:string ;
    rdfs:comment "A planned booking of a patient with a practitioner. It may be fulfilled by an Encounter."^^xsd:string ;
    rdfs:subClassOf owl:Thing .

hc:Department a owl:Class ;
    rdfs:label "Department"^^xsd:string ;
    rdfs:comment "An organizational unit of a hospital, optionally focused on a clinical specialty."^^xsd:string ;
    rdfs:subClassOf hc:Organization .

hc:Medication a owl:Class ;
    rdfs:label "Medication"^^xsd:string ;
    rdfs:comment "A drug as a concept (for example metformin), not a dispensed package or a patient's dose."^^xsd:string ;
    rdfs:subClassOf owl:Thing .

hc:SpecialtyScheme a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "Clinical specialties (illustrative subset)"^^xsd:string ;
    skos:prefLabel "Clinical specialties (illustrative subset)"@en .

hc:DiagnosticTest a owl:Class ;
    rdfs:label "Diagnostic Test"^^xsd:string ;
    rdfs:comment "An examination ordered to obtain diagnostic information."^^xsd:string ;
    rdfs:subClassOf owl:Thing .

hc:Practitioner a owl:Class ;
    rdfs:label "Practitioner"^^xsd:string ;
    rdfs:comment "A person who delivers clinical care or clinical support in a healthcare setting."^^xsd:string ;
    rdfs:subClassOf hc:Person .

hc:Observation a owl:Class ;
    rdfs:label "Observation"^^xsd:string ;
    rdfs:comment "A measurement or assertion about a patient made at a point in time, such as a vital sign or a result."^^xsd:string ;
    rdfs:subClassOf owl:Thing .

hc:Specialty a owl:Class ;
    rdfs:label "Specialty"^^xsd:string ;
    rdfs:comment "A clinical specialty such as cardiology. A SKOS concept, not a class hierarchy of practitioners."^^xsd:string ;
    rdfs:subClassOf skos:Concept .

hc:Treatment a owl:Class ;
    rdfs:label "Treatment"^^xsd:string ;
    rdfs:comment "A planned therapeutic intervention intended to address a condition."^^xsd:string ;
    rdfs:subClassOf owl:Thing .

hc:Person a owl:Class ;
    rdfs:label "Person"^^xsd:string ;
    rdfs:comment "A human being. Roles (patient, practitioner) are classes here for simplicity; a person who is both is typed with both."^^xsd:string ;
    rdfs:subClassOf owl:Thing .

hc:Encounter a owl:Class ;
    rdfs:label "Encounter"^^xsd:string ;
    rdfs:comment "An interaction between a patient and healthcare practitioners during which care is delivered. It occurred (or is occurring); a future booking is an Appointment."^^xsd:string ;
    rdfs:subClassOf owl:Thing .

hc:Patient a owl:Class ;
    rdfs:label "Patient"^^xsd:string ;
    rdfs:comment "A person who receives, or is registered to receive, healthcare services."^^xsd:string ;
    rdfs:subClassOf hc:Person .

[] a owl:AllDisjointClasses ;
    owl:members ( hc:Specialty hc:AdministrativeGender hc:EncounterType hc:MedicationCategory ) .

[] a owl:AllDisjointClasses ;
    owl:members ( hc:Ward hc:Room hc:Bed ) .

[] a owl:AllDisjointClasses ;
    owl:members ( hc:Person hc:Organization hc:Location hc:Encounter hc:Appointment hc:Condition hc:Observation hc:Procedure hc:Treatment hc:DiagnosticTest hc:Medication hc:Prescription hc:Allergy hc:Identifier hc:CodeConcept hc:CarePlan ) .

