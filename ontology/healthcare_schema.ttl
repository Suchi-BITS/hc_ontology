# Healthcare ontology SCHEMA (TBox + controlled vocabularies). GENERATED by scripts/generate_hc_ontology.py.
# Do not edit by hand. Synthetic instance data lives in data/sample_data.ttl.
@prefix hc: <http://example.org/healthcare-hospital.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/healthcare-hospital.owl> a owl:Ontology ;
    rdfs:label "Healthcare Hospital Ontology"^^xsd:string ;
    rdfs:comment "A small, bounded teaching ontology for hospital care: people, organizations, encounters, conditions, observations, medication and terminology binding. Not a clinical system. See docs/ontology-engineering.md."^^xsd:string ;
    owl:versionInfo "2.0.0"^^xsd:string .

hc:AntidiabeticMedication a owl:Class ;
    rdfs:label "antidiabetic medication"^^xsd:string ;
    rdfs:comment "A Medication categorized as antidiabetic. Defined, not asserted: a reasoner classifies medications into it."^^xsd:string ;
    rdfs:subClassOf hc:Medication ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( hc:Medication [ a owl:Restriction ;
                        owl:hasValue hc:MedCategoryAntidiabetic ;
                        owl:onProperty hc:medicationCategory ] ) ] .

hc:Chemotherapy a owl:Class ;
    rdfs:label "Chemotherapy"^^xsd:string ;
    rdfs:comment "A Treatment delivered through cytotoxic drugs."^^xsd:string ;
    rdfs:subClassOf hc:Treatment .

hc:EncounterTypeAmbulatory a hc:EncounterType,
        owl:NamedIndividual ;
    rdfs:label "Ambulatory"^^xsd:string ;
    skos:inScheme hc:EncounterTypeScheme ;
    skos:notation "AMB"^^xsd:string ;
    skos:prefLabel "Ambulatory"@en .

hc:EncounterTypeEmergency a hc:EncounterType,
        owl:NamedIndividual ;
    rdfs:label "Emergency"^^xsd:string ;
    skos:inScheme hc:EncounterTypeScheme ;
    skos:notation "EMER"^^xsd:string ;
    skos:prefLabel "Emergency"@en .

hc:EncounterTypeVirtual a hc:EncounterType,
        owl:NamedIndividual ;
    rdfs:label "Virtual"^^xsd:string ;
    skos:inScheme hc:EncounterTypeScheme ;
    skos:notation "VR"^^xsd:string ;
    skos:prefLabel "Virtual"@en .

hc:GenderFemale a hc:AdministrativeGender,
        owl:NamedIndividual ;
    rdfs:label "Female"^^xsd:string ;
    skos:inScheme hc:AdministrativeGenderScheme ;
    skos:notation "female"^^xsd:string ;
    skos:prefLabel "Female"@en .

hc:GenderMale a hc:AdministrativeGender,
        owl:NamedIndividual ;
    rdfs:label "Male"^^xsd:string ;
    skos:inScheme hc:AdministrativeGenderScheme ;
    skos:notation "male"^^xsd:string ;
    skos:prefLabel "Male"@en .

hc:GenderOther a hc:AdministrativeGender,
        owl:NamedIndividual ;
    rdfs:label "Other"^^xsd:string ;
    skos:inScheme hc:AdministrativeGenderScheme ;
    skos:notation "other"^^xsd:string ;
    skos:prefLabel "Other"@en .

hc:GenderUnknown a hc:AdministrativeGender,
        owl:NamedIndividual ;
    rdfs:label "Unknown"^^xsd:string ;
    skos:inScheme hc:AdministrativeGenderScheme ;
    skos:notation "unknown"^^xsd:string ;
    skos:prefLabel "Unknown"@en .

hc:InpatientEncounter a owl:Class ;
    rdfs:label "inpatient encounter"^^xsd:string ;
    rdfs:comment "An Encounter whose encounterType is Inpatient. Defined, not asserted."^^xsd:string ;
    rdfs:subClassOf hc:Encounter ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( hc:Encounter [ a owl:Restriction ;
                        owl:hasValue hc:EncounterTypeInpatient ;
                        owl:onProperty hc:encounterType ] ) ] .

hc:InsuranceAgent a owl:Class ;
    rdfs:label "Insurance Agent"^^xsd:string ;
    rdfs:comment "A person acting for an insurer in coverage or claim matters."^^xsd:string ;
    rdfs:subClassOf hc:Person .

